# Environment & Credentials (CRITICAL - Keeps API keys safe)
.env
*.env
.env.*
!.env.example
*.key
*.pem

# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/

# Local Virtual Environments
env/
venv/
.venv/
ENV/

# OS and IDE files
.DS_Store
Thumbs.db
.vscode/
.idea/

# Database files
*.db-journal
*.sqlite3-journal

# Uploads directory contents (keeps test photos out of repo)
static/uploads/*
!static/uploads/.gitkeep
